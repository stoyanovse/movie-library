# Copy this file to .env before running `docker compose up`.
#
# DB_NAME / DB_USER / DB_PASSWORD are LOCAL, throwaway values for the
# Dockerized MariaDB container — not real production credentials, and
# safe to leave as-is.
DB_NAME=movie_library
DB_USER=movielibrary
DB_PASSWORD=movielibrary
DB_ROOT_PASSWORD=rootpassword

# OMDB_API_KEY is the one value you MUST set yourself — it's a personal,
# rate-limited key tied to your own OMDb account and can't be shared or
# defaulted. Get a free one in seconds at:
# https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=
